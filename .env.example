# API + Worker
DATABASE_URL=            # from Zerops `db` service  -> ${db_connectionString}
VALKEY_HOST=             # -> ${valkey_hostname}
VALKEY_PORT=6379         # -> ${valkey_port}
VALKEY_PASSWORD=         # -> ${valkey_password}  (Zerops Valkey requires auth)
S3_ENDPOINT=             # from Zerops `storage` service -> ${storage_apiUrl}
S3_ACCESS_KEY=           # -> ${storage_accessKeyId}
S3_SECRET_KEY=           # -> ${storage_secretAccessKey}
S3_BUCKET=               # -> ${storage_bucketName}  (name is generated; never hardcode)
# Worker (+ API if it calls the LLM)
LLM_API_KEY=             # set as a Zerops SECRET env var on `worker` — never commit
# Web
NEXT_PUBLIC_API_URL=     # API service PUBLIC url, set in the Zerops GUI after enabling its subdomain
